# VeroApp SMS Guard — Offline Build & Tooling Environment Template
# Copy this file to `.env` for local release/signing scripts only.
# VeroApp SMS Guard operates 100% offline on-device; no runtime cloud API keys are used.

# Optional: Offline Ed25519 License Signing Key Path (used by scripts/license_tool.py)
VERO_ED25519_PRIVATE_KEY_PATH=scripts/.ed25519_private.key

# Optional: Android Keystore Configuration (for CI/CD release signing)
ANDROID_KEYSTORE_PATH=android/app/upload-keystore.jks
ANDROID_KEY_ALIAS=veroapp_sms_guard_upload

# Optional: iOS App Group Identifier (Apple IdentityLookup & WidgetKit sync)
IOS_APP_GROUP_ID=group.com.veroapp.smsguard.filter
